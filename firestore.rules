rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write to members and login_activity collections
    match /members/{document=**} {
      allow read, write: if true;
    }
    match /login_activity/{document=**} {
      allow read, write: if true;
    }
    match /polls/{document=**} {
      allow read, write: if true;
    }
    match /meeting_sessions/{document=**} {
      allow read, write: if true;
    }
    match /messages/{document=**} {
      allow read, write: if true;
    }
    match /notifications/{document=**} {
      allow read, write: if true;
    }
    match /speech_evaluations/{document=**} {
      allow read, write: if true;
    }
    match /time_steward_records/{document=**} {
      allow read, write: if true;
    }
    match /filler_counter_records/{document=**} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
